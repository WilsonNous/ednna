# EDNNA application
SECRET_KEY=
ADMIN_PASSWORD=

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# EDDY specialist integration (enable only when endpoint exists)
EDDY_BASE_URL=
EDDY_API_TOKEN=
EDDY_TIMEOUT_SECONDS=10

EDDY_ENABLED=false

# OIDC authentication (Azure Entra ID or another OIDC provider)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tid
OIDC_USER_CLAIM=oid
OIDC_SERVICE_CLAIM=azp
OIDC_ROLES_CLAIM=roles
OIDC_PERMISSIONS_CLAIM=scp

# Human approval API (requires OIDC + migrations 001/002)
APPROVAL_API_ENABLED=false

# Controlled ACTION API (requires OIDC + EDDY + migrations 001/002)
ACTION_API_ENABLED=false

# Optional catalog of additional specialist intelligences
SPECIALIST_MANIFEST_PATH=

# Authenticated multi-specialist QUERY API
MULTIAGENT_QUERY_API_ENABLED=false

# Authenticated specialist event ingress (requires OIDC + migration 004)
EVENT_INGRESS_API_ENABLED=false

# Azure Service Bus event delivery (Managed Identity preferred)
SERVICEBUS_OUTBOX_ENABLED=false
SERVICEBUS_NAMESPACE=
SERVICEBUS_TOPIC=
SERVICEBUS_MANAGED_IDENTITY_CLIENT_ID=

# Azure Service Bus consumer (one-shot worker entrypoint)
SERVICEBUS_CONSUMER_ENABLED=false
SERVICEBUS_SUBSCRIPTION=
SERVICEBUS_MAX_DELIVERY_ATTEMPTS=5

# Separate Service Bus worker runtime
SERVICEBUS_WORKER_POLL_SECONDS=2

# Require successful specialist handshake before routing
SPECIALIST_HANDSHAKE_ENFORCED=false

# Persist specialist availability across processes/instances (requires migration 005)
SPECIALIST_AVAILABILITY_DURABLE=false

# Separate specialist handshake health worker (requires durable availability)
SPECIALIST_HEALTH_WORKER_ENABLED=false
SPECIALIST_HEALTH_POLL_SECONDS=30
